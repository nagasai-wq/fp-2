<!DOCTYPE html>
<html>

<head>
    <title>
        <%= title %>
    </title>

    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 40px;
        }

        h1 {
            color: darkblue;
        }

        li {
            margin: 10px;
            padding: 10px;
            border-bottom: 1px solid #ccc;
        }

        .total {
            font-weight: bold;
            margin-top: 20px;
        }
    </style>
</head>

<body>

    <h1>
        <%= title %>
    </h1>

    <% if (users.length===0) { %>

        <p>No users available.</p>

        <% } else { %>

            <ul>

                <% users.forEach(user=> { %>

                    <li>
                        <strong>
                            <%= user.name %>
                        </strong>
                        -
                        <%= user.email %>
                            -
                            <%= user.age %> years
                    </li>

                    <% }); %>

            </ul>

            <p class="total">
                Total users: <%= users.length %>
            </p>

            <% } %>

</body>

</html>
